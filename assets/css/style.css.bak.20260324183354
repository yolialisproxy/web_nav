/*搜索部分背景样式*/
.header-big.css-color{
    background-image: url('../assets/images/writing-landscape.jpg');
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    animation: fadeIn 1.5s ease-in-out;
}

@keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
}

/*卡片悬停效果*/
.url-card .card {
    transition: transform 0.3s ease, box-shadow 0.3s ease;
}
.url-card .card:hover {
    transform: translateY(-5px);
    box-shadow: 0 8px 25px rgba(0,0,0,0.15);
}

/*全局按钮样式*/
.btn, .back-home a {
    transition: all 0.3s ease;
}
.btn:hover, .back-home a:hover {
    transform: translateY(-2px);
}

/*搜索热词样式调整*/
.search-hot-text{
    position: absolute;
    z-index: 100;
    width: 100%;
    border-radius: 0 0 10px 10px;
    background: #FFF;
    box-shadow: 0px 4px 5px 0px #cccccc94;
    overflow: hidden;
}
.search-hot-text ul{
    margin: 0;
    padding: 5px 0;
}
.search-hot-text ul li{
    line-height: 30px;
    font-size: 14px;
    padding: 0px 25px;
    color: #777;
    cursor: pointer;
}
.io-black-mode .search-hot-text ul li{
    color: #fff;
}    
.search-hot-text ul li.current{
    background: #f1f1f1;
    color: #2196f3;
}
.search-hot-text ul li:hover{
    background: #f1f1f1;
    color: #2196f3;
    cursor: pointer;
}

/* 搜索modal美化样式 */
.hover-bg:hover {
    background-color: rgba(0,123,255,0.1) !important;
    cursor: pointer;
}

.search-modal .modal-header {
    border-bottom: 1px solid rgba(0,0,0,0.1);
}

.search-modal .s-type-list label {
    cursor: pointer;
    transition: all 0.3s ease;
    min-width: 90px;
    text-align: center;
    padding: 8px 14px !important;
}

.search-modal .s-type-list label:hover {
    transform: translateY(-2px);
}

.search-modal .search-group {
    display: none;
    animation: fadeInUp 0.4s ease forwards;
}

.search-modal .search-group.s-current {
    display: block;
}

.search-modal .search-group .search-type li label {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: flex-start;
    padding: 10px 12px;
    border-radius: 10px;
    background-color: #f8f9fa;
    border: 1px solid rgba(0,0,0,0.07);
    margin-bottom: 8px;
}

.search-modal .search-group .search-type li label:hover {
    background-color: rgba(103, 123, 245, 0.1);
    border-color: rgba(103, 123, 245, 0.35);
}

.search-modal .search-group .search-type li label i {
    min-width: 26px;
    text-align: center;
}

@keyframes fadeInUp {
    from {
        opacity: 0;
        transform: translateY(20px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

.search-modal .modal-dialog {
    max-width: 1040px;
    width: 92%;
    margin: 1.5rem auto;
}

.search-modal .modal-content {
    width: 100%;
    overflow: hidden;
    border-radius: 18px;
    background: rgba(255,255,255,0.98);
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
    border: none;
    box-shadow: 0 20px 60px rgba(0,0,0,0.3);
}

.modal {
    z-index: 1091 !important;
    pointer-events: auto !important;
}

.modal-backdrop {
    z-index: 1089 !important;
    pointer-events: auto !important;
    backdrop-filter: none !important;
    -webkit-backdrop-filter: none !important;
    background: rgba(0,0,0,0.3) !important;
}

.modal-content {
    pointer-events: auto !important;
}

.modal-dialog {
    pointer-events: auto !important;
}

.modal-body {
    pointer-events: auto !important;
}

.modal-header {
    pointer-events: auto !important;
}

.search-modal .search-group,
.search-modal .search-tabs,
.search-modal .search-tab-list,
.search-modal .s-type-list,
.search-modal .search-type,
.search-modal .super-search-fm,
.search-modal .input-group,
.search-modal .form-control,
.search-modal label,
.search-modal input,
.search-modal button {
    pointer-events: auto !important;
}

.modal-backdrop.show {
    opacity: 0.55 !important;
}

.search-modal .search-group h6 {
    font-size: 1rem;
    line-height: 1.4;
}

.search-modal .search-type li {
    margin-bottom: 0.55rem;
}

.search-modal .search-group .search-type li label {
    min-height: 44px;
}

.search-modal .hot-tags .badge {
    cursor: pointer;
    transition: all 0.3s ease;
}

.search-modal .hot-tags .badge:hover {
    transform: scale(1.05);
    box-shadow: 0 4px 8px rgba(0,0,0,0.2);
}

.search-modal .super-search-fm .input-group {
    box-shadow: 0 4px 15px rgba(0,0,0,0.1);
}

/* 强制修复搜索Modal上的flaot/定位冲突 */
.search-modal .search-tabs {
    position: relative;
    margin-bottom: 1.2rem;
    text-align: center;
}

.search-modal .search-tab-list,
.search-modal .s-type-list {
    position: static !important;
    display: flex !important;
    flex-wrap: wrap !important;
    justify-content: center !important;
    align-items: center !important;
    gap: 0.5rem !important;
    width: 100% !important;
    margin-bottom: 0.8rem !important;
    background: transparent !important;
    box-shadow: none !important;
    padding: 0 !important;
    border: 0 !important;
    top: auto !important;
    left: auto !important;
}

.search-modal .search-tab-list::before,
.search-modal .s-type-list::before {
    display: none !important;
}

.search-modal .search-tab-list label,
.search-modal .s-type-list label {
    position: relative !important;
    display: inline-flex !important;
    padding: 8px 16px !important;
    border-radius: 22px !important;
    min-width: 85px !important;
    line-height: 1.2 !important;
    font-size: 14px !important;
    border: 1px solid rgba(0, 0, 0, 0.08) !important;
    background: rgba(255,255,255,0.9) !important;
    color: #444 !important;
}

.search-modal .search-tab-list label.active,
.search-modal .search-tab-list label:hover,
.search-modal .s-type-list label.active,
.search-modal .s-type-list label:hover {
    background: linear-gradient(135deg, #4863ff, #5f8bff) !important;
    color: #fff !important;
    border-color: #4f75ff !important;
    box-shadow: 0 8px 24px rgba(69, 104, 255, 0.25) !important;
}

.search-modal .s-type-list .anchor {
    display: none !important;
}

.search-modal .search-group {
    display: none !important;
    opacity: 0;
    transform: translateY(8px);
    transition: all 0.25s ease;
}

.search-modal .search-group.s-current {
    display: block !important;
    opacity: 1 !important;
    transform: translateY(0) !important;
}


.search-modal .super-search-fm .form-control:focus {
    border-color: #007bff;
    box-shadow: 0 0 0 0.2rem rgba(0,123,255,0.25);
}

/* 键盘快捷键提示 */
kbd {
    background-color: #f7f7f7;
    border: 1px solid #ccc;
    border-radius: 3px;
    box-shadow: 0 1px 0 rgba(0,0,0,0.2), 0 0 0 2px #fff inset;
    color: #333;
    display: inline-block;
    font-family: Arial, sans-serif;
    font-size: 11px;
    line-height: 1.4;
    margin: 0 .1em;
    padding: .1em .6em;
    text-shadow: 0 1px 0 #fff;
}
.search-hot-text ul li span{
    display: inline-block;
    width: 20px;
    height: 20px;
    font-size: 12px;
    line-height: 20px;
    text-align: center;
    background: #e5e5e5;
    margin-right: 10px;
    border-radius: 10px;
    color: #999;
}

footer.main-footer .footer-text a:hover {
    color: red;
}

/*卡片悬停效果增强*/
.url-card .card {
    transition: transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease;
    border: 1px solid #e9ecef;
}
.url-card .card:hover {
    transform: translateY(-8px) scale(1.02);
    box-shadow: 0 12px 30px rgba(0,0,0,0.2);
    border-color: #007bff;
}

/*全局按钮和链接样式*/
.btn, .back-home a, .navbar-nav a {
    transition: all 0.3s ease;
}
.btn:hover, .back-home a:hover, .navbar-nav a:hover {
    transform: translateY(-2px);
}

/*搜索框聚焦效果*/
#search-text:focus {
    box-shadow: 0 0 10px rgba(0,123,255,0.5);
    border-color: #007bff;
}

/*响应式改进*/
@media (max-width: 768px) {
    .header-big.css-color {
        background-attachment: scroll;
        background-size: cover;
    }
    .url-card .card:hover {
        transform: translateY(-5px) scale(1.01);
    }
}

/* 强制header背景样式 */
.header-big.css-color {
    background-image: linear-gradient(180deg, rgba(255, 126, 95, 0.8), rgba(254, 180, 123, 0.8)), url('https://images.unsplash.com/photo-1544947950-fa07a98d237f?ixlib=rb-4.0.3&auto=format&fit=crop&w=1920&q=90') !important;
    background-size: cover !important;
    background-position: center top !important;
    background-repeat: no-repeat !important;
    min-height: 450px !important;
    position: relative !important;
    transition: all .6s ease !important;
}

/* 粒子动画背景 */
.header-big.css-color::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-image:
        radial-gradient(circle at 20% 80%, rgba(120, 119, 198, 0.3) 0%, transparent 50%),
        radial-gradient(circle at 80% 20%, rgba(255, 119, 198, 0.3) 0%, transparent 50%),
        radial-gradient(circle at 40% 40%, rgba(120, 119, 198, 0.3) 0%, transparent 50%);
    background-size: 300px 300px, 200px 200px, 400px 400px;
    background-position: 0% 0%, 100% 0%, 50% 100%;
    animation: float 20s ease-in-out infinite;
    pointer-events: none;
}

@keyframes float {
    0%, 100% { transform: translateY(0px) rotate(0deg); }
    33% { transform: translateY(-10px) rotate(120deg); }
    66% { transform: translateY(10px) rotate(240deg); }
}

.header-big.css-color .s-search .super-search-fm {
    background: rgba(255, 255, 255, 0.9) !important;
    border-radius: 14px !important;
    box-shadow: 0 12px 24px rgba(0, 0, 0, 0.18) !important;
    border: 1px solid rgba(255, 255, 255, .85) !important;
    backdrop-filter: blur(8px) !important;
}

/* 文本阴影和排版 */
.header-big.css-color .s-search .search-key,
.header-big.css-color .s-search .submit,
.header-big.css-color .s-type-list label {
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.1);
    color: var(--text-color) !important;
}

.header-big.css-color .s-search .super-search-fm .search-key::placeholder {
    color: #a0aec0;
}

/* 卡片内容样式 */
.url-card .card-body {
    padding: 20px;
}

.url-card .card-title {
    font-size: 16px;
    font-weight: 600;
    margin-bottom: 8px;
    color: var(--text-color);
}

.url-card .card-text {
    font-size: 14px;
    color: #718096;
    line-height: 1.5;
}

/* 图标样式 */
.url-card .card img {
    width: 48px;
    height: 48px;
    border-radius: 8px;
    margin-right: 16px;
}

/* 悬停时的图标动画 */
.url-card .card:hover img {
    transform: scale(1.1);
    transition: transform 0.3s ease;
}

@keyframes pageFadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
}

html, body {
    overflow-x: hidden;
}

body, .content-site {
    animation: pageFadeIn 0.9s ease forwards !important;
}

/* 颜色主题：文艺蓝紫 + 暖橙 */

.io-black-mode body, .io-black-mode html {
    background: #111 !important;
    color: #c6c9cf !important;
}

.io-grey-mode body, .io-grey-mode html {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%) fixed !important;
    color: #2b2b2b !important;
}

.main-content {
    min-width: 0;
}

@media (min-width: 768px) {
    .main-content {
        margin-left: 170px !important;
        width: calc(100vw - 170px) !important;
        overflow-x: hidden;
    }
    .sidebar-nav.mini-sidebar + .main-content {
        margin-left: 60px !important;
        width: calc(100vw - 60px) !important;
        overflow-x: hidden;
    }
}

:root {
    --primary-color: #667eea;
    --secondary-color: #764ba2;
    --accent-color: #f093fb;
    --text-color: #2d3748;
    --bg-light: #f7fafc;
}

/* 标题样式 */
h1, h2, h3, h4, h5, h6 {
    font-weight: 600;
    color: var(--text-color);
    margin-bottom: 1rem;
}

/* 链接样式 */
a {
    color: var(--primary-color);
    text-decoration: none;
    transition: color 0.3s ease;
}

a:hover {
    color: var(--secondary-color);
}

/* 按钮样式 */
.btn-primary {
    background: linear-gradient(135deg, var(--primary-color), var(--secondary-color));
    border: none;
    border-radius: 8px;
    padding: 10px 20px;
    color: white;
    font-weight: 500;
    transition: all 0.3s ease;
}

.btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(102, 126, 234, 0.4);
}

/* 卡片样式增强 */
.url-card .card {
    border-radius: 12px !important;
    overflow: hidden;
    transition: all 0.3s ease;
}

.url-card .card:hover {
    transform: translateY(-8px) scale(1.02);
    box-shadow: 0 16px 40px rgba(0,0,0,0.2);
}

/* 搜索框样式 */
#search-text {
    border-radius: 8px 0 0 8px;
    border: 1px solid #e2e8f0;
    padding: 12px 16px;
    font-size: 16px;
    transition: all 0.3s ease;
}

#search-text:focus {
    border-color: var(--primary-color);
    box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.1);
}

/* 导航栏样式 */
.navbar {
    background: rgba(255, 255, 255, 0.95) !important;
    backdrop-filter: blur(10px) !important;
    border-bottom: 1px solid rgba(255, 255, 255, 0.2) !important;
}

/* 侧边栏样式 */
.sidebar-nav {
    background: rgba(255, 255, 255, 0.95) !important;
    backdrop-filter: blur(10px) !important;
}

/* 响应式优化 */
@media (max-width: 768px) {
    .header-big.css-color {
        min-height: 350px !important;
    }
    .page-container {
        margin-top: 20px;
    }
    .url-card .card:hover {
        transform: translateY(-5px) scale(1.01);
    }
}

/*About页面*/
.panel .panel-body a {color: #007bff;}
.panel .panel-body a:hover {color: #979898;}

/*网格背景*/
.io-grey-mode .page-container .grid-bg {
    background-image: linear-gradient(rgba(50, 0, 0, 0.05) 1px, transparent 0), linear-gradient(90deg, rgba(50, 0, 0, 0.05) 1px, transparent 0); 
    background-size: 15px 15px;
    background-color: #d8d8d8;
}















