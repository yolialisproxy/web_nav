/* 分类内容区域 - 自动填充宽度 */
#category-sections {
  flex: 1;
  width: 100%;
  min-height: 200px;
}
#category-sections .section {
  width: 100%;
}
#category-sections .cards {
  width: 100%;
}

/* 内容栏自动填充宽度 - 修复空白问题 */
#pageContent {
  display: flex;
  flex-direction: column;
  min-height: 100%;
  width: 100%;
}

#category-sections {
  flex: 1;
  width: 100% !important;
  min-height: calc(100vh - 200px);
}

#category-sections .section {
  width: 100%;
  max-width: 100%;
}

#category-sections .cards {
  width: 100%;
  grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
}

#category-sections .card {
  flex: 1;
  min-width: 200px;
}

/* 导航栏与侧边栏顶端对齐 */
#sidebar > nav {
  margin-top: 0 !important;
  padding-top: 10px !important;
}

#sidebar .nav-item:first-child {
  margin-top: 0 !important;
}

/* 内容栏背景色与网站整体协调 */
#category-sections {
  background: transparent !important;
}

.main-content {
  background: transparent !important;
}

#pageContent {
  background: transparent !important;
}

/* 暗色模式内容栏背景 */
@media (prefers-color-scheme: dark) {
  #category-sections,
  .main-content,
  #pageContent {
    background: transparent !important;
  }
}

body.dark #category-sections,
body.dark .main-content,
body.dark #pageContent {
  background: transparent !important;
}
