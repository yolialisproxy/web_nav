/* 颜色主题：温暖文艺调 - 橙紫绿 */
:root {
    --primary-color: #ff7e5f;
    --secondary-color: #feb47b;
    --accent-color: #6c5ce7;
    --success-color: #00b894;
    --text-color: #2d3436;
    --bg-light: #fdfdfd;
    --bg-card: rgba(255, 255, 255, 0.95);
}

/* 全局字体 - 文艺感 */
body, html {
    font-family: 'Nunito', 'PingFang SC', 'Helvetica Neue', Arial, sans-serif !important;
    font-size: 15px;
    line-height: 1.6;
    color: var(--text-color);
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%) fixed !important;
    min-height: 100vh;
    transition: all 0.3s ease;
    overflow: hidden;
}

/* 页面整体 - 卡片化社区风 */
.page-container,
.about-container,
.content-site,
.header-big,
.section,
.url-card .card,
.sidebar-nav {
    background: var(--bg-card) !important;
    border-radius: 16px !important;
    box-shadow: 0 8px 32px rgba(0,0,0,0.1) !important;
    border: 1px solid rgba(255,255,255,0.2) !important;
    backdrop-filter: blur(12px) !important;
    transition: all 0.4s ease !important;
}

#sidebar.sidebar-nav {
    position: fixed !important;
    top: 0 !important;
    left: 0 !important;
    height: 100vh !important;
    width: 170px !important;
    overflow: hidden !important;
    z-index: 1081 !important;
}

.sidebar-nav.mini-sidebar {
    width: 60px !important;
}

.page-container > #sidebar.sidebar-nav + .main-content,
.page-container > .sidebar-nav + .main-content {
    margin-left: 170px !important;
    width: calc(100vw - 170px) !important;
}

.page-container > #sidebar.sidebar-nav.mini-sidebar + .main-content,
.page-container > .sidebar-nav.mini-sidebar + .main-content {
    margin-left: 60px !important;
    width: calc(100vw - 60px) !important;
}

.main-content {
    overflow-y: auto !important;
    height: 100vh !important;
    transition: margin-left .2s ease, width .2s ease;
}

.page-container {
    margin-top: 0;
    position: relative;
    width: auto;
    max-width: 100%;
    min-width: 0;
    box-sizing: border-box;
}

.page-container::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(45deg, var(--primary-color), var(--secondary-color), var(--accent-color));
    border-radius: 20px;
    z-index: -1;
    opacity: 0.05;
    pointer-events: none;
}

