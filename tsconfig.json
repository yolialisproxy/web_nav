{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES6",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "./",
    "removeComments": false,
    "sourceMap": true,
    "noEmitOnError": true
  },
  "include": [
    "assets/js/**/*.ts",
    "assets/js/**/*.tsx",
    "tests/**/*.spec.ts",
    "scripts/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "**/*.bak.ts",
    "**/*.tmp.ts"
  ]
}